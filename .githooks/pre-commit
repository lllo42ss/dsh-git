#!/usr/bin/env sh
set -eu

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY="py -3"
else
  echo "pre-commit: python not found; skipping checks (CI still runs them)" >&2
  exit 0
fi

$PY -B scripts/check_repo.py
$PY -B -m unittest discover -s tests -v
